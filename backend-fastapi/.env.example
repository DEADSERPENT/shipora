PORT=5001
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/waste-disposal

# AI provider — set LLM_PROVIDER to anthropic | openai | gemini
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# EcoBot's multi-agent tool-calling (agents/) is Anthropic-only, gated on
# ANTHROPIC_API_KEY specifically — set regardless of LLM_PROVIDER above to
# enable the tracking/complaints/support specialist agents.

# STT/TTS — reuses OPENAI_API_KEY above, no separate key needed. Voice
# features (mic input, spoken replies) silently disable if that key is a placeholder.
STT_PROVIDER=openai
TTS_PROVIDER=openai
