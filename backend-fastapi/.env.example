PORT=5001
CLIENT_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here
MONGO_URI=mongodb://localhost:27017/waste-disposal

# Gemini is the only LLM — powers intent classification, tool-calling data
# retrieval, and summarization (agents/base.py, agents/orchestrator.py,
# services/llm.py). Without GEMINI_API_KEY, everything falls back to
# keyword-based routing and a zero-key rule-based reply.
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_api_key_here
OPENAI_API_KEY=your_api_key_here

# STT/TTS — reuses OPENAI_API_KEY above, no separate key needed. Voice
# features (mic input, spoken replies) silently disable if that key is a placeholder.
STT_PROVIDER=openai
TTS_PROVIDER=openai
