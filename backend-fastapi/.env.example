# development | test | production. Production enforces https-only CORS origins, forbids the
# in-memory database fallback and disables open admin sign-up (see ADMIN_SIGNUP_CODE).
APP_ENV=development
PORT=5001

# Browser origin(s) allowed to call the API. Use CORS_ORIGINS for several (comma separated).
# Wildcards are rejected. In production these must be public https origins.
CLIENT_URL=http://localhost:3000
# CORS_ORIGINS=https://app.example.com,https://admin.example.com

# REQUIRED, no default — the server refuses to start without a strong one (32+ chars, random).
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# NOTE: changing this value invalidates every issued token; users just sign in again.
JWT_SECRET=

MONGO_URI=mongodb://localhost:27017/shipora

# The only LLM is a local Ollama model: intent classification, tool-calling data retrieval and the plain-text fallback
# (services/ollama_client.py). Needs `ollama serve` and a tool-capable model (`ollama pull qwen2.5:3b`). If Ollama is
# unreachable everything falls back to keyword routing, database answers for tracking, and the rule-based knowledge base.
OLLAMA_MODEL=qwen2.5:3b             # best fit for a 6 GB GPU: fully resident, ~1.5 s per answer
# OLLAMA_URL=http://localhost:11434
# OLLAMA_TIMEOUT_SECONDS=30           # hard budget per model call
# OLLAMA_COOLDOWN_SECONDS=30          # after an outage-type failure, skip Ollama for this long and use the fallbacks
OPENAI_API_KEY=your_api_key_here

# STT/TTS — reuses OPENAI_API_KEY above, no separate key needed. Voice
# features (mic input, spoken replies) silently disable if that key is a placeholder.
STT_PROVIDER=openai
TTS_PROVIDER=openai

# Local open-source voice (optional) — no API key. Needs: pip install -r requirements-local-voice.txt
# plus model files, see docs/LOCAL_VOICE.md. Switch by setting STT_PROVIDER=faster_whisper / TTS_PROVIDER=piper above.
# LOCAL_MODELS_DIR=local_models
# FASTER_WHISPER_MODEL=small            # tiny|base|small|medium|large-v3, or a model directory
# FASTER_WHISPER_DEVICE=auto            # auto|cpu|cuda
# FASTER_WHISPER_COMPUTE_TYPE=default   # float16 on GPU, int8 on CPU
# FASTER_WHISPER_LANGUAGE=              # empty = auto-detect
# PIPER_VOICE=en_US-lessac-medium.onnx  # file in local_models/piper/ (English is the tested language)

# Same-day bike delivery pricing and limits (defaults shown; see services/pricing.py)
# FARE_BASE_INR=48          # base fare, covers the first FARE_INCLUDED_KM
# FARE_INCLUDED_KM=1
# FARE_PER_KM_INR=12        # each further km
# FARE_FREE_WEIGHT_KG=5     # parcels up to this weight add nothing
# FARE_PER_EXTRA_KG_INR=4   # each kg above it
# MAX_PARCEL_KG=20          # two-wheeler carrying limit
# ETA_BASE_MINUTES=30       # rider assignment + pickup
# ETA_MINUTES_PER_KM=4

# Local LLM tuning (see docs/LOCAL_VOICE.md).
# OLLAMA_NUM_CTX=4096                 # IMPORTANT: Ollama's default context (up to 131k) evicts the model from a small GPU
# CLASSIFIER_MODE=hybrid              # keyword router answers instantly when decisive; the LLM only sees ambiguous messages
# OLLAMA_VOICE_TIMEOUT_SECONDS=8      # per-call LLM budget on voice turns
# VOICE_MAX_SPOKEN_CHARS=420          # spoken replies stop at a sentence boundary (chat text is unchanged)
# VOICE_WARMUP=true                   # load STT/TTS/LLM at startup so the first caller isn't the one who waits

# Speech-to-text for noisy phone-quality audio (English). nemo-parakeet-tdt-0.6b-v3 was far better than whisper-base under
# noise (90 % vs 50 % exact tracking numbers at 15 dB SNR) and faster on CPU (~0.3 s vs ~0.7 s), at a ~670 MB download.
# Put the int8 files in local_models/onnx_stt/nemo-parakeet-tdt-0.6b-v3/ (see docs/LOCAL_VOICE.md), then:
# STT_PROVIDER=onnx_local
# ONNX_STT_MODEL=nemo-parakeet-tdt-0.6b-v3

# Automatic dispatch: a new shipment is matched to the nearest available delivery agent without anyone in Operations assigning it
# (services/dispatch.py). Operations can still reassign by hand.
# AUTO_ASSIGN_ENABLED=true
# AUTO_ASSIGN_DELAY_SECONDS=3          # a short "assigning a rider..." beat before the match shows up

# Rider simulator (services/simulator.py): simulated delivery agents pick up and deliver by themselves, publishing GPS and status
# changes through the same paths a real rider's phone uses, so the live map and tracking look real. ON by default only on the in-memory
# database; against a real database it must be asked for (it creates agents flagged isSimulated).
# SIMULATION_ENABLED=true
# SIM_FLEET_SIZE=6                     # simulated agents kept on the road
# SIM_SPEED=15                         # 1 = real time; 15 = a 25 km/h rider covers ground 15x faster so a demo finishes in minutes
# SIM_TICK_SECONDS=2
